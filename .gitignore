# dependencies
node_modules/

# Chrome dev profile (52MB, do not commit)
.chrome-profile-copy/
.tmp-chrome-profile/

# logs
*.log
serve.out
serve.err
chrome-stderr.log
chrome-stdout.log

# dev / debug artifacts (in repo root only — docs/ may keep panel-*.png)
/_tm.zip
/_tm_extracted
/_tm.txt
/_data_url.txt
/_row.txt
/panel-*.png
/linux-sb-*.png
/linux-sb-*.html
/after-toggle.png
/tm-*.png

# OS
.DS_Store
Thumbs.db

# editor
.vscode/

# secrets (never commit)
.env

.idea/
*.swp
# disposable Chrome profiles for live site probes
.tmp-probe/
.any-chrome-profile/


# additional disposable probe profiles (was .tmp-probe/ already, this catches the suffixed variants)
.tmp-probe*/


# ephemeral CDP probe scripts (Greasy Fork sync, login probes)
_probe*.mjs
_fill.mjs
_submit.mjs
_resync.mjs
_probe_login.mjs
# real (non-synthetic) fixture captures from live site probes
test/fixtures-real/
# disposable CDP capture scripts
_capture.mjs
_inspect.mjs


# disposable CDP probe screenshots
_probe*.png


# disposable CDP probe helpers (used during dev/debug, do not commit)
/_*.mjs
/_*.png


# raw third-party userscript sources captured for analysis (large; replace with re-fetch)
docs/superpowers/specs/*.user.js


# Tampermonkey extension bundle (re-download from the CRX at dev time; do not commit)
/tm-extension/
/tampermonkey.crx

# ad-hoc dev notes / patches
/_ask.txt
/.patch-readFromDom.txt

# vision-toolkit scratch artifacts (cropped screenshots etc.)
.dsh-vision-toolkit/

# analysis screenshots of the running panel
/final-*.png
.superdesign/tmp/
